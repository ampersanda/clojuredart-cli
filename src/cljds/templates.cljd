(ns cljds.templates
  (:require [clojure.string :as string]))

(defn- render
  "Replace {{key}} placeholders in template with values from data map.
   Throws if any unfilled placeholders remain."
  [template data]
  (let [result (reduce-kv
                 (fn [s k v]
                   (string/replace s (str "{{" (name k) "}}") (str v)))
                 template
                 data)
        unfilled (re-find #"\{\{[a-zA-Z_-]+\}\}" result)]
    (when unfilled
      (throw (ex-info (str "Unfilled template placeholder: " unfilled)
                      {:placeholder unfilled})))
    result))

(def ^:private deps-edn-template
  "{:paths [\"src\"]
 :deps {org.clojure/clojure {:mvn/version \"1.10.1\"}
        tensegritics/clojuredart
        {:git/url \"https://github.com/tensegritics/ClojureDart.git\"
         :sha \"{{sha}}\"}}
 :aliases {:cljd {:main-opts [\"-m\" \"cljd.build\"]}}
 :cljd/opts {:kind {{project-type}}
             :main {{namespace}}}}")

(def ^:private dart-main-template
  "(ns {{namespace}})

(defn main []
  (print \"hello, world\"))")

(def ^:private flutter-main-template
  "(ns {{namespace}}
  (:require [\"package:flutter/material.dart\" :as m]
            [cljd.flutter :as f]))

(defn main []
  (f/run
    (m/MaterialApp
      .title \"Welcome to Flutter\"
      .theme (m/ThemeData .primarySwatch m.Colors/pink)
      .home (m/Scaffold
         .appBar (m/AppBar .title (m/Text \"Welcome to ClojureDart\"))
         .body   (m/Center
                  .child (m/Text \"This text is Centered.\"
                                 .style (m/TextStyle
                                         .color m.Colors/red
                                         .fontSize 32.0)))))))")

(def ^:private templates
  {[:dart :deps-edn]     deps-edn-template
   [:flutter :deps-edn]  deps-edn-template
   [:dart :main]         dart-main-template
   [:flutter :main]      flutter-main-template})

(defn render-deps-edn
  "Render deps.edn template for the given project type, SHA, and namespace."
  [project-type sha namespace]
  (render (get templates [project-type :deps-edn])
          {:project-type (str project-type)
           :sha          sha
           :namespace    namespace}))

(defn render-main
  "Render main source file template for the given project type and namespace."
  [project-type namespace]
  (render (get templates [project-type :main])
          {:namespace namespace}))
