(ns cljds.generators.core
  (:require
    ["dart:io" :refer [exit Process]]
    [cljds.utils.names :refer [names]]
    [cljds.consts :refer [sha-url fallback-sha]]
    [cljds.templates :as templates]
    [cljds.utils.io :as io]
    [clojure.string :as string]
    [cljds.utils.log :refer [err logger]]
    [cljds.utils.shell :as shell]
    ["package:http/http.dart" :refer [Client]]))

(defn valid-sha?
  "Check if sha is a 40-character hex string"
  [sha]
  (and (some? sha)
       (re-matches #"^[0-9a-f]{40}$" sha)))

(defn- fetch-sha
  "Fetch latest SHA from ClojureDart repository. Returns nil on failure."
  []
  (let [client (Client)]
    (try
      (let [content (await (.get client sha-url))
            status-code (.-statusCode content)]
        (if (= status-code 200)
          (let [result (filter (fn [e] (seq e)) (string/split-lines (.-body content)))
                latest (last result)]
            (when (valid-sha? latest)
              latest))
          nil))
      (catch
        #_{:clj-kondo/ignore [:unresolved-symbol]}
        dynamic _e
        nil)
      (finally
        (.close client)))))

(defn latest-sha
  "Getting available latest SHA from ClojureDart repository.
   Prompts user to use fallback SHA on failure, or aborts."
  []
  (let [loading (.progress logger (str "Getting latest version from " (.toString sha-url)))
        sha (await (fetch-sha))]
    (if (some? sha)
      (do
        (.complete loading (str "Using " sha))
        sha)
      (do
        (.fail loading "Failed to fetch latest SHA!")
        (let [use-fallback (.confirm logger
                             (str "Use fallback SHA (" fallback-sha ")?")
                             .defaultValue true)]
          (if use-fallback
            (do
              (.info logger (str "Using fallback SHA: " fallback-sha))
              fallback-sha)
            (do
              (err "Aborting: no valid SHA available.")
              nil)))))))

(defn check-prerequisites
  "Verify that required tools are on PATH. Returns list of missing tools."
  []
  (let [tools ["clj"]
        missing (atom [])]
    (doseq [tool tools]
      (try
        (let [result (await (shell/run "which" [tool]))]
          (when-not (= 0 (.-exitCode result))
            (swap! missing conj tool)))
        (catch
          #_{:clj-kondo/ignore [:unresolved-symbol]}
          dynamic _e
          (swap! missing conj tool))))
    @missing))

(defn- make-files
  "Create project files: deps.edn and main source file."
  [project-type sha dir-name namespace]
  (let [dir (await (io/mkdir dir-name))]
    (let [loading (.progress logger (str "Creating '" (.-path dir) "' project"))]
      (let [edn-file (await (io/mkfile (str dir-name "/deps.edn")))
            content (templates/render-deps-edn project-type sha namespace)]
        (await (.writeAsString edn-file content)))
      (.complete loading (str "Project '" (.-path dir) "' created!")))

    (let [loading (.progress logger "Making core file project")
          path (str dir-name "/src/" dir-name "/core.cljd")
          main-file (await (io/mkfile path :recursive true))
          content (templates/render-main project-type namespace)]
      (await (.writeAsString main-file content))
      (.complete loading (str "Core file '" path "' created!")))

    (let [loading (.progress logger "Initializing project")
          result (await
                   (shell/run "clj" ["-M:cljd" "init"] .workingDirectory dir-name))]
      (await (io/mkdir (str dir-name "/src/" dir-name) :recursive true))
      (if (= 0 (.-exitCode result))
        (do
          (.complete loading "Project initialized!")
          (let [output (.-stdout result)]
            (when (seq output)
              (.detail logger (str "\n" output)))))
        (do
          (.fail loading "Failed to initialize project!")
          (let [stderr (.-stderr result)]
            (when (seq stderr)
              (.detail logger (str "\n" stderr))))
          (throw (Exception. (str "clj -M:cljd init failed (exit code " (.-exitCode result) ")"))))))))

(defn generate-project
  "Unified project generation. Returns true on success, false on failure."
  [project-name project-type opts]
  (let [{:keys [name dir]} (names project-name)
        namespace (str name ".core")
        output (:output opts)
        dir-name (if output
                   (str output "/" dir)
                   dir)]
    (let [provided-sha (:sha opts)
          sha (if provided-sha
                (if (valid-sha? provided-sha)
                  (do
                    (.info logger (str "Using provided SHA: " provided-sha))
                    provided-sha)
                  (do
                    (err (str "Invalid SHA: " provided-sha ". Must be a 40-character hex string."))
                    (exit 1)
                    nil))
                (await (latest-sha)))]
      (when (nil? sha)
        (err "No valid SHA available. Cannot generate project.")
        (exit 1))
      (try
        (await (make-files project-type sha dir-name namespace))
        true
        (catch
          #_{:clj-kondo/ignore [:unresolved-symbol]}
          dynamic e
          (err (str "Failed to generate project: " e))
          (when (io/exists? dir-name)
            (try
              (let [loading (.progress logger "Cleaning up partial files...")]
                (await (io/delete-dir dir-name))
                (.complete loading "Cleaned up."))
              (catch
                #_{:clj-kondo/ignore [:unresolved-symbol]}
                dynamic _
                (err (str "Warning: could not clean up directory '" dir-name "'. Please remove it manually.")))))
          false)))))
